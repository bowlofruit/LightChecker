# =============================================================================
# Unity (C#) + Android Studio (Kotlin/Gradle)
# Папки без "/" на початку — ігноруються в будь-якій підпапці (наприклад
# LightCheckerUnity/Library, LightCheckerUnity/Temp).
# Якщо Library/Temp/Builds вже були в індексі: git rm -r --cached -- <шлях>/Library <шлях>/Temp <шлях>/Builds
# =============================================================================

# -----------------------------------------------------------------------------
# Unity (великі/генеровані папки — десятки тисяч файлів)
# -----------------------------------------------------------------------------
.utmp/
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Uu]IElements[Ss]chema/
*.log

# MemoryCaptures can get excessive in size.
[Mm]emoryCaptures/

# Recordings can get excessive in size
[Rr]ecordings/

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider cache
.vs/
.idea/

# Autogenerated solution and project files (keep .slnx if used)
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics
crashlytics-build.properties

# Packed Addressables
[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
[Aa]ssets/[Ss]treamingAssets/aa.meta
[Aa]ssets/[Ss]treamingAssets/aa/*

# -----------------------------------------------------------------------------
# Android Studio / Kotlin / Gradle
# -----------------------------------------------------------------------------
# Gradle
.gradle/
**/build/
gradle-app.setting
!gradle-wrapper.jar
.gradletasknamecache

# Android Studio / IntelliJ (in Android plugin or standalone Android project)
.idea/
*.iml
*.ipr
*.iws
out/
.idea/caches/
.idea/shelf/
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml

# Local config (SDK path, etc.)
local.properties
*.local

# Android build outputs (apk/aab already in Unity section)
*.dex
*.class
.externalNativeBuild/
.cxx/
*.hprof
captures/

# Kotlin
*.kotlin_module

# OS
.DS_Store
Thumbs.db
