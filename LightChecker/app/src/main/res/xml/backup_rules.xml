<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules (API 30 and below).
   Back up the Room DB (saved places — user data, no secrets).
   Exclude the DataStore preferences (transient UI/debug toggles) so a restore
   starts with a clean, re-synced UI state.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
</full-backup-content>
