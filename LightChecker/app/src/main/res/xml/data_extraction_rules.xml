<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules (API 31+) for cloud backup and device-to-device transfer.
   Back up the Room DB (saved places — user data, no secrets).
   Exclude the DataStore preferences (transient UI/debug toggles).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
