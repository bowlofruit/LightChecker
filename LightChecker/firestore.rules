rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Публічне читання всього дерева schedules (узгоджено з планом schedules/**)
    match /schedules/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
